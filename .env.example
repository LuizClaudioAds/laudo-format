# AI provider. Supported: google (default) or mock.
AI_PROVIDER=google
# Model id passed to the provider.
AI_MODEL=gemini-3.8-flash
# Google AI Studio key: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Enables the deterministic mock classifier for local tests/e2e.
# Never enable this in a public production deployment.
ALLOW_MOCK_AI=false

# Optional. Upstash Redis is used for distributed rate limiting.
# Without it the app falls back to an in-memory limiter (per instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt used to hash client IPs before they are used as rate-limit keys.
IP_HASH_SALT=change-me

# Requests per minute.
RATE_LIMIT_FORMAT=10
RATE_LIMIT_SPELL=5

# Public URL of the deployment, used in metadata and docs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
